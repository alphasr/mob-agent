# Copy to .env and fill in. Never commit .env.

# Where people open the dashboard. https://... gets a certificate automatically (point DNS here first);
# http://localhost to try it on this machine.
PUBLIC_URL=https://dash.example.com

# Generate each with: openssl rand -hex 32   (hex: the database password goes into a URL)
POSTGRES_PASSWORD=
AUTH_SECRET=

# A GitHub OAuth app (github.com/settings/developers → New OAuth App):
#   Homepage URL: your PUBLIC_URL
#   Authorization callback URL: your PUBLIC_URL + /api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
